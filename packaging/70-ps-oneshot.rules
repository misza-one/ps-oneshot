# PS One Shot — access for the logged-in user to PlayStation controllers.
# Install: sudo install -m644 70-ps-oneshot.rules /etc/udev/rules.d/ && sudo udevadm control --reload && sudo udevadm trigger
# (then reconnect the controller)

# Lightbar and player LEDs (sysfs attributes cannot use uaccess, so make them writable).
ACTION=="add", SUBSYSTEM=="leds", DRIVERS=="playstation", RUN+="/bin/sh -c 'chmod 0666 /sys%p/brightness; [ -e /sys%p/multi_intensity ] && chmod 0666 /sys%p/multi_intensity; true'"

# Gamepad + touchpad event nodes and the hidraw node (mic button) for the active seat user.
SUBSYSTEM=="input", KERNEL=="event*", ATTRS{name}=="*DualSense*", TAG+="uaccess"
SUBSYSTEM=="hidraw", KERNELS=="*:054C:0CE6.*", TAG+="uaccess"
SUBSYSTEM=="hidraw", KERNELS=="*:054C:0DF2.*", TAG+="uaccess"

# Virtual keyboard/pointer (menu navigation, touchpad mouse, stick scrolling).
KERNEL=="uinput", SUBSYSTEM=="misc", TAG+="uaccess", OPTIONS+="static_node=uinput"
